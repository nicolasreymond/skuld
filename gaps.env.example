# gaps.env — SECRET (identifiants HEIG + token ntfy). À NE JAMAIS committer.
# Copie ce fichier : cp gaps.env.example gaps.env, puis remplis les valeurs.

# --- Scraper gaps-cli (surveille GAPS) ---
GAPS_LOGIN_USERNAME=prenom.nom
GAPS_LOGIN_PASSWORD=change-me
GAPS_SCRAPER_API_URL=http://skuld-adapter:8080
GAPS_SCRAPER_API_KEY=change-me-cle-partagee
GAPS_HISTORY_GRADES_FILE=/history/grades.json

# --- Adaptateur → ntfy (notification de nouvelle note) ---
ADAPTER_API_KEY=change-me-cle-partagee    # DOIT être identique à GAPS_SCRAPER_API_KEY
# ntfy : le service public https://ntfy.sh, ou ton propre serveur ntfy.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=change-me-topic-unique-et-secret
NTFY_TOKEN=                                # vide si topic public ; sinon ton token ntfy
